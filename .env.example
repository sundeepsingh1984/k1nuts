# Server-only Google Places API (New) credentials.
GOOGLE_PLACES_API_KEY=

# Optional: skips the Text Search lookup when the K1 Nuts Place ID is known.
GOOGLE_PLACE_ID=

# Canonical storefront URL used by SEO metadata, sitemap and campaigns.
NEXT_PUBLIC_SITE_URL=https://nourish-and-nut.sales-k1nuts.chatgpt.site

# Private administration. Store only a SHA-256 password hash, never the password.
K1_ADMIN_USERNAME=
K1_ADMIN_PASSWORD_SHA256=
K1_ADMIN_SESSION_SECRET=

# Bulk email delivery. Use a verified sender such as K1 Nuts <offers@example.com>.
RESEND_API_KEY=
MARKETING_FROM_EMAIL=
MARKETING_BATCH_LIMIT=250

# Meta WhatsApp Cloud API. Campaigns use an approved template with one body variable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional future external identity provider configuration. The current private
# Sites deployment continues to use secure ChatGPT sign-in until public auth is approved.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Shiprocket API user credentials and pickup location name.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# K1 dispatch address used by shipping rate and label requests.
K1_SHIP_FROM_NAME=K1 Nuts
K1_SHIP_FROM_ADDRESS=Aluchi Bagh
K1_SHIP_FROM_CITY=Srinagar
K1_SHIP_FROM_STATE=Jammu & Kashmir
K1_SHIP_FROM_PIN=190008
K1_SHIP_FROM_PHONE=
K1_SHIP_FROM_EMAIL=

# Amazon Shipping / Selling Partner API private application.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_SHIPPING_BUSINESS_ID=
